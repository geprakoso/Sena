# =============================================================================
# Site Configuration (Public - Exposed to Browser)
# =============================================================================
# These variables are accessible in both server and client components.
# They MUST be prefixed with NEXT_PUBLIC_ to be available in the browser.
# =============================================================================

NEXT_PUBLIC_SITE_NAME="Your Site Name"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_VERSION="0.1.0"
NEXT_PUBLIC_SITE_DESCRIPTION="A professional Next.js application"
NEXT_PUBLIC_SITE_AUTHOR="Your Name or Company"
NEXT_PUBLIC_SITE_LANGUAGE="en"

# Branding
NEXT_PUBLIC_LOGO_URL="/images/logo/logo.svg"
NEXT_PUBLIC_LOGO_NAME="Sena Logo"
NEXT_PUBLIC_FAVICON_URL="/favicon.ico"
NEXT_PUBLIC_OG_IMAGE_URL="/og-image.png"

# =============================================================================
# API Configuration
# =============================================================================
# Base URL for your API (internal or external)
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api"
NEXT_PUBLIC_API_VERSION="v1"

# External API endpoints (if applicable)
# NEXT_PUBLIC_EXTERNAL_API_URL="https://api.external-service.com"

# =============================================================================
# Authentication (Public)
# =============================================================================
# Auth provider names displayed to users
NEXT_PUBLIC_AUTH_PROVIDER_NAME="Credentials"
NEXT_PUBLIC_ENABLE_MAGIC_LINK="false"
NEXT_PUBLIC_ENABLE_OAUTH="true"

# =============================================================================
# Analytics & Monitoring (Public)
# =============================================================================
# Google Analytics / GTM (measurement ID only - no secrets)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_CONTAINER_ID=""

# Other analytics (Plausible, Fathom, etc.)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_API_HOST="https://plausible.io"

# =============================================================================
# Feature Flags (Public)
# =============================================================================
# Toggle features without redeploying (use with caution - visible in browser)
NEXT_PUBLIC_FEATURE_BETA_DASHBOARD="false"
NEXT_PUBLIC_FEATURE_NEW_ONBOARDING="false"
NEXT_PUBLIC_FEATURE_DEBUG_PANEL="false"

# =============================================================================
# Social & SEO (Public)
# =============================================================================
NEXT_PUBLIC_TWITTER_HANDLE="@yourhandle"
NEXT_PUBLIC_FACEBOOK_APP_ID=""
NEXT_PUBLIC_GITHUB_URL="https://github.com/yourusername/yourrepo"

# =============================================================================
# =============================================================================
# SERVER-ONLY CONFIGURATION (Never exposed to Browser)
# =============================================================================
# These variables are ONLY available in Server Components, API Routes,
# Server Actions, and middleware. NEVER prefix sensitive values with NEXT_PUBLIC_.
# =============================================================================

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=""
DATABASE_DIRECT_URL=""
DATABASE_POOL_SIZE="10"

# Redis / Cache
REDIS_URL=""
REDIS_TOKEN=""

# =============================================================================
# Authentication (Server Secrets)
# =============================================================================
# NextAuth.js / Auth.js v5 (recommended for Next.js 15+)
AUTH_SECRET="your-auth-secret-here-min-32-chars-long"
AUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# JWT Configuration
JWT_SECRET=""
JWT_MAX_AGE="30d"

# =============================================================================
# Email / SMTP
# =============================================================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@example.com"
SMTP_SECURE="false"

# Transactional Email Services (Resend, SendGrid, etc.)
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# =============================================================================
# Storage / File Uploads
# =============================================================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME=""
AWS_S3_PUBLIC_URL=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# =============================================================================
# Payment Processing
# =============================================================================
STRIPE_PUBLISHABLE_KEY=""          # Can be public, but kept here for consistency
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_SUCCESS_URL="http://localhost:3000/success"
STRIPE_CANCEL_URL="http://localhost:3000/cancel"

# =============================================================================
# Security
# =============================================================================
# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Rate Limiting
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW_MS="60000"

# Content Security Policy nonce (optional)
CSP_NONCE_SECRET=""

# =============================================================================
# Third-Party Services (Server-side APIs)
# =============================================================================
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# External service API keys
# THIRD_PARTY_API_KEY=""
# THIRD_PARTY_API_SECRET=""

# =============================================================================
# Deployment / Infrastructure
# =============================================================================
# NODE_ENV is set automatically by Next.js, but can be overridden
# NODE_ENV="development"

# Vercel specific (set automatically on Vercel deployments)
# VERCEL="1"
# VERCEL_URL=""
# VERCEL_ENV="development"

# =============================================================================
# Development / Debug
# =============================================================================
# Enable detailed logging
DEBUG="false"
LOG_LEVEL="info"

# Pretty print JSON responses in development
PRETTY_PRINT_LOGS="true"
